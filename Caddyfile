frostbyte-api.southeastasia.cloudapp.azure.com {
	# API Gateway: Route all /api requests to the backend service.
	handle /api/* {
		# Handler for explicitly versioned requests (v1).
		@alreadyV1 path /api/v1/*
		handle @alreadyV1 {
			reverse_proxy api:8080
		}

		# Backward Compatibility Layer: Injects /v1 prefix for legacy or unversioned requests.
		handle {
			uri strip_prefix /api
			rewrite * /api/v1{path}
			reverse_proxy api:8080
		}
	}
	
	# WebSocket route
	handle /ws {
		reverse_proxy api:8080
	}

	# Frontend (default)
	handle {
		reverse_proxy frontend:3000
	}
}
