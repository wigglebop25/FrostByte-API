meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: https://localhost:443/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "adminuser",
    "password": "YOUR_PASSWORD_HERE"
  }
}

script:post-response {
  let data = res.getBody();
  if (data.token) {
    bru.setVar("token", data.token);
  }
}
